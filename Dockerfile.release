# Self contained image for `docker run -p 8000:8000 -e KEERA_API_KEY=... ghcr.io/besaif/mutz`:
# code, the built data and the BGE-M3 + reranker weights baked in. Build with scripts/release_image.sh,
# which stages the context (data/ and the models are not in the normal Docker context).
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*          # WeasyPrint needs Pango
WORKDIR /app
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY src/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
ENV HF_HOME=/app/models MUTZ_ALLOW_MODEL_DOWNLOAD=0
COPY models/ /app/models/hub/
COPY data/ /app/data/
COPY src/ /app/
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
